# Template for /etc/dnsmasq.d/local.conf — do NOT copy this file as-is.
# Generate it from the repo's .env with envsubst, then restart dnsmasq:
#
#   set -a; source .env; set +a
#   envsubst '${DOMAIN} ${HOST}' < dnsmasq/local.conf.template | sudo tee /etc/dnsmasq.d/local.conf
#   sudo systemctl restart dnsmasq

no-resolv
server=1.1.1.1
server=8.8.8.8
listen-address=0.0.0.0
domain-needed
bogus-priv
cache-size=1000
domain=home
local=/home/

address=/home.${DOMAIN}/${HOST}
address=/portainer.${DOMAIN}/${HOST}
address=/files.${DOMAIN}/${HOST}
address=/transmission.${DOMAIN}/${HOST}
address=/jellyfin.${DOMAIN}/${HOST}
address=/books.${DOMAIN}/${HOST}
address=/documents.${DOMAIN}/${HOST}
address=/syncthing.${DOMAIN}/${HOST}
address=/immich.${DOMAIN}/${HOST}
address=/duplicati.${DOMAIN}/${HOST}
